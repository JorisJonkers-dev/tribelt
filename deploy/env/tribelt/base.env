# The Process scope (deploy-kit spec/v1, chapter 10, Configuration).
TRIBELT_ENV=production
TRIBELT_ADDR=:8080
AUTO_MIGRATE=true
BASE_URL=${exposure:tribelt.public#url}
GSC_SITE_URL=${exposure:tribelt.public#url}/
BING_SITE_URL=${exposure:tribelt.public#url}/

PGHOST=${dependency:platform-postgres.host}
PGPORT=${dependency:platform-postgres.port}
PGDATABASE=tribelt_db
PGSSLMODE=disable
PGUSER=${dependency:platform-postgres.username}
PGPASSWORD=${dependency:platform-postgres.password}

OIDC_ISSUER=${exposure:auth.public#url}
OIDC_CLIENT_ID=tribelt
OIDC_REDIRECT_URL=${exposure:tribelt.public#url}/auth/callback
OIDC_CLIENT_SECRET=${secret:secret/data/platform/tribelt#oidc.client_secret}
SESSION_KEY=${secret:secret/data/tribelt-system/keys#session_key}
VISITOR_HMAC_KEY=${secret:secret/data/tribelt-system/keys#visitor_hmac_key}
