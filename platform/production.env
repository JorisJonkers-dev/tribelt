# Non-secret production environment values for tribelt.
# Secrets NEVER live here; they arrive via envFrom from the platform secret store:
#   PGUSER, PGPASSWORD (Vault dynamic credentials), OIDC_CLIENT_SECRET, SESSION_KEY,
#   VISITOR_HMAC_KEY, GSC_SERVICE_ACCOUNT_JSON, BING_API_KEY (the last two may be empty: import off).
TRIBELT_ENV=production
TRIBELT_ADDR=:8080
AUTO_MIGRATE=true
BASE_URL=https://tribelt.jorisjonkers.dev
PGHOST=postgres.data-system.svc.cluster.local
PGPORT=5432
PGDATABASE=tribelt_db
PGSSLMODE=disable
OIDC_ISSUER=https://auth.jorisjonkers.dev
OIDC_CLIENT_ID=tribelt
OIDC_REDIRECT_URL=https://tribelt.jorisjonkers.dev/auth/callback
GSC_SITE_URL=https://tribelt.jorisjonkers.dev/
BING_SITE_URL=https://tribelt.jorisjonkers.dev/
